# Copy to .env and fill in. Never commit .env.

GCP_PROJECT_ID=pulso-madrid
GCP_REGION=europe-southwest1
BQ_LOCATION=EU
BQ_DATASET_RAW=raw
BQ_DATASET_FACTS=facts
BQ_DATASET_MARTS=marts
BQ_DATASET_DIMENSIONS=dimensions
BQ_DATASET_OPS=ops
GCS_RAW_BUCKET=pulso-madrid-raw

# Data sources. Renfe's realtime feed needs no key: verified against the live endpoint.
# Leave RENFE_GTFS_RT_URL blank to use the default in apps/api/src/app/config.py.
RENFE_GTFS_RT_URL=https://gtfsrt.renfe.com/vehicle_positions.json
CRTM_GTFS_URL=

# API
API_CORS_ORIGINS=http://localhost:3000
WAREHOUSE_REFRESH_SECONDS=900
VEHICLES_CACHE_SECONDS=10
UPSTREAM_TIMEOUT_SECONDS=10

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
